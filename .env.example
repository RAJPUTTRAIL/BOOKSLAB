# Copy to .env.local and adjust.
# Local MongoDB (or an Atlas URI: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookslab?retryWrites=true&w=majority)
MONGODB_URI="mongodb://127.0.0.1:27017/bookslab"
# 32+ random characters used to sign session cookies
AUTH_SECRET="change-me-to-a-long-random-string-0123456789"
# Optional: allows POST /api/seed in production with header x-seed-token
# "true" shows forgot-password reset codes in the sign-in modal and server console (local testing only — set "false" in production)
RESET_CODE_PREVIEW="true"
SEED_TOKEN=""
# Payments: "sandbox" simulates UPI/card payments; "live" requires a gateway in src/lib/payments.ts
PAYMENTS_MODE="sandbox"
NEXT_PUBLIC_PAYMENTS_MODE="sandbox"
# Email (Resend). Without a key, emails are printed to the terminal instead of being sent.
RESEND_API_KEY=re_123456789
# Sender. onboarding@resend.dev (testing) only delivers to your own Resend account email.
# After verifying your domain at resend.com/domains, use it, e.g. EMAIL_FROM="Bookslab <no-reply@yourdomain.in>"
EMAIL_FROM="Bookslab <onboarding@resend.dev>"
# Inbox that receives contact-form messages (with onboarding@resend.dev: your Resend account email)
CONTACT_TO="you@example.com"
# Public site URL used for links inside emails
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
